generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String      @id @default(cuid())
  username           String      @unique
  passwordHash       String
  role               String      @default("user")
  balance            Int         @default(0)
  status             String      @default("active")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  creditLogs         CreditLog[] @relation("CreditLogUser")
  operatedCreditLogs CreditLog[] @relation("CreditLogOperator")
  videoTasks         VideoTask[]
}

model CreditLog {
  id            String   @id @default(cuid())
  userId        String
  type          String
  amount        Int
  beforeBalance Int
  afterBalance  Int
  reason        String?
  operatorId    String?
  createdAt     DateTime @default(now())
  user          User     @relation("CreditLogUser", fields: [userId], references: [id])
  operator      User?    @relation("CreditLogOperator", fields: [operatorId], references: [id])

  @@index([userId])
  @@index([operatorId])
  @@index([createdAt])
}

model VideoTask {
  id           String   @id @default(cuid())
  userId       String
  prompt       String
  imageUrl     String?
  videoUrl     String?
  model        String
  aspectRatio  String?
  cost         Int
  status       String   @default("pending")
  apiTaskId    String?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([apiTaskId])
  @@index([createdAt])
}
