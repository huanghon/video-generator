# AI Video Portal Configuration

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"
SETUP_SECRET="replace-with-a-private-setup-secret"
AUTH_COOKIE_SECURE=true

# Upload storage. Use local on a single Linux server, cloudinary on Render, vercel-blob on Vercel.
STORAGE_PROVIDER=local
UPLOAD_DIR=/var/www/video-generator/uploads
PUBLIC_UPLOAD_BASE_URL=https://your-domain.com

# Required only when STORAGE_PROVIDER=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=video-generator

# Required only when STORAGE_PROVIDER=vercel-blob.
BLOB_READ_WRITE_TOKEN=

# Optional: force mock mode while the real provider is not connected.
VIDEO_PROVIDER_MOCK=true
VIDEO_PROVIDER_BASE_URL=https://api.loova.ai/api

# Required for encrypting API keys saved in the admin Key pool.
KEY_ENCRYPTION_SECRET="replace-with-a-long-random-encryption-secret"
